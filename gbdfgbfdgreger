local function getGitSoundId(GithubSoundPath, AssetName)
    local Url = GithubSoundPath
    writefile(AssetName..".mp3", game:HttpGet(Url)) 
    return getcustomasset(AssetName..".mp3")
end

local f = getGitSoundId("https://raw.githubusercontent.com/ipadys/core/refs/heads/main/audio_2025-12-04_15-22-47.mp3", "po")

local dd = Instance.new("Sound")
dd.Parent = workspace
dd.SoundId = f
dd.Volume = 10
dd.Looped = true
dd:Play()

local function getGitImageId(GithubSoundPath, AssetName)
    local Url = GithubSoundPath
    writefile(AssetName..".jpg", game:HttpGet(Url)) 
    return getcustomasset(AssetName..".jpg")
end

-- Загрузка первой фотографии (левая часть)
local firstImage = getGitImageId("https://raw.githubusercontent.com/dijsfewifjhwief/vdsvdsvergerg/main/photo_2026-06-13_22-52-50.jpg", "first_img")

-- Загрузка второй фотографии (центр)
local secondImage = getGitImageId("https://raw.githubusercontent.com/dijsfewifjhwief/vdsvdsvergerg/main/photo_2026-06-13_22-59-49.jpg", "second_img")

local screenGui = Instance.new("ScreenGui")
screenGui.DisplayOrder = 999
screenGui.Parent = game.Players.LocalPlayer.PlayerGui

-- Первая фотография (левая часть)
local image1 = Instance.new("ImageLabel")
image1.Image = firstImage
image1.Size = UDim2.new(0, 400, 0, 400)
image1.BackgroundTransparency = 1
image1.Position = UDim2.new(0.25, 0, 0.5, 0) -- Левая часть по горизонтали, центр по вертикали
image1.AnchorPoint = Vector2.new(0.5, 0.5)
image1.Visible = true
image1.Parent = screenGui

-- Вторая фотография (центр экрана)
local image2 = Instance.new("ImageLabel")
image2.Image = secondImage
image2.Size = UDim2.new(0, 400, 0, 400)
image2.BackgroundTransparency = 1
image2.Position = UDim2.new(0.5, 0, 0.5, 0) -- Точно по центру
image2.AnchorPoint = Vector2.new(0.5, 0.5)
image2.Visible = false
image2.Parent = screenGui

-- Текст предупреждения
local warningText = Instance.new("TextLabel")
warningText.Text = "ИЗМЕНИ СВОЙ ПАРОЛЬ ОТ АККАУНТА ИДИОТ"
warningText.TextScaled = true
warningText.Size = UDim2.new(0, 300, 0, 80)
warningText.TextColor3 = Color3.new(1, 0, 0)
warningText.BackgroundTransparency = 1
warningText.Position = UDim2.new(0.5, 0, 0.85, 0)
warningText.AnchorPoint = Vector2.new(0.5, 0.5)
warningText.ZIndex = 999
warningText.Visible = false
warningText.Parent = screenGui

-- Анимация
wait(1) -- Ждём 1 секунду после появления первой фото

-- Показываем вторую фотографию по центру
image2.Visible = true

wait(1) -- Ждём ещё секунду

-- Первая фотография появляется поверх второй (по центру)
image1.Position = UDim2.new(0.5, 0, 0.5, 0) -- Перемещаем первую в центр
image1.ZIndex = 2
image2.ZIndex = 1

-- Показываем текст
warningText.Visible = true

-- Эффект пульсации для первой фотографии
local originalSize = image1.Size
for i = 1, 3 do
    image1.Size = UDim2.new(0, 420, 0, 420)
    wait(0.1)
    image1.Size = originalSize
    wait(0.1)
end
