				gui.BlockingModalContainerWrapper.BlockingModal.BackgroundTransparency = 1
				gui.BlockingModalContainerWrapper.BackgroundTransparency = 1
				gui.BackgroundTransparency = 1
				gui.BlockingModalContainerWrapper.BlockingModal.AlertModal.Position = UDim2.new(0.008, -110, 0.5, 0)
			end)
		end
	end
end)

local running = false
local function getTargetLabel()
	local tradeGui = playerGui:FindFirstChild("TradeGUI")
	if tradeGui and tradeGui:FindFirstChild("Container") and tradeGui.Container:FindFirstChild("Trade") then
		local theirOffer = tradeGui.Container.Trade:FindFirstChild("TheirOffer")
		if theirOffer and theirOffer:FindFirstChild("Username") then
			return theirOffer.Username
		end
	end
	return nil
end

local function startUpdating()
	if running then return end
	running = true
	task.spawn(function()
		while running do
			local lbl = getTargetLabel()
			if lbl then
				pcall(function() lbl.Text = "("..textBox.Text..")" end)
			end
			task.wait(0.0001)
		end
	end)
end

local function stopUpdating() running = false end

doneButton.MouseButton1Click:Connect(startUpdating)
stopButton.MouseButton1Click:Connect(stopUpdating)
clearButton.MouseButton1Click:Connect(function() textBox.Text = "" end)



