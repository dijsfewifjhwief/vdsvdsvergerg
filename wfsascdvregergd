local minimized = false
local originalSize = frame.Size

minimizeButton.MouseButton1Click:Connect(function()
	minimized = not minimized
	if minimized then
		for _, child in pairs(frame:GetChildren()) do
			if child ~= header and child ~= minimizeButton and not child:IsA("UICorner") then
				child.Visible = false
			end
		end
		frame.Size = UDim2.new(0, 180, 0, 40)
		minimizeButton.Text = "+"
	else
		for _, child in pairs(frame:GetChildren()) do
			if not child:IsA("UICorner") then
				child.Visible = true
			end
		end
		frame.Size = originalSize
		minimizeButton.Text = "-"
	end
end)

local baseNames = {
	"masha","dasha","sasha","anya","vika","lera","mila","sofia","diana","nastya",
	"artem","pasha","ilya","roma","vlad","daniil","egor","nikita","stepa","kostya",
	"ava","mia","lily","ella","zoe","ruby","emma","chloe","grace","sophie",
	"alex","ryan","jack","liam","jay","mark","adam","sam","tom","leo"
}
local suffixes = {"pro","yt","plays","xx","girl","boy"}
local usedNicks = {}

local function generateRandomNick()
	local base = baseNames[math.random(1, #baseNames)]
	local nick
	if math.random() < 0.7 then
		local year = math.random(2008, 2016)
		nick = base .. tostring(year)
	else
		nick = base
		if math.random() < 0.5 then
			local specials = {228,1337,777,999}
			nick = nick .. tostring(specials[math.random(1,#specials)])
		else
			nick = nick .. tostring(math.random(10,9999))
		end
		if math.random() < 0.5 then
			nick = nick .. "_" .. suffixes[math.random(1,#suffixes)]
		end
	end
	if usedNicks[nick] then
		return generateRandomNick()
	else
		usedNicks[nick] = true
		return nick
	end
end

randomButton.MouseButton1Click:Connect(function()
	textBox.Text = generateRandomNick()
end)

local function getTradeNickname()
	local tradeGui = playerGui:FindFirstChild("TradeGUI")
	if tradeGui and tradeGui:FindFirstChild("Container") and tradeGui.Container:FindFirstChild("Trade") then
		local theirOffer = tradeGui.Container.Trade:FindFirstChild("TheirOffer")
		if theirOffer and theirOffer:FindFirstChild("Username") then
			return theirOffer.Username.Text
		end
	end
	return nil
end

blockButton.MouseButton1Click:Connect(function()
	local name = textBox.Text
	if name ~= "" then
		local target = Players:FindFirstChild(name)
		if target then
			game:GetService('StarterGui'):SetCore('PromptBlockPlayer', target)
			task.spawn(function()
				repeat task.wait() until game:GetService('CoreGui'):FindFirstChild('BlockingModalScreen')
